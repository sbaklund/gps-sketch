# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Port the server listens on locally (Render sets its own PORT automatically)
PORT=3001

# MapTiler API key — get a free one at maptiler.com
# Used for terrain-RGB tiles (higher detail than Open-Meteo).
# Leave blank to disable the maptiler source; Open-Meteo will be the fallback.
MAPTILER_KEY=your_maptiler_key_here

# Comma-separated list of allowed CORS origins.
# In development: http://localhost:8080,http://127.0.0.1:8080
# In production: your deployed front-end URL, e.g. https://topo-route-art.onrender.com
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
